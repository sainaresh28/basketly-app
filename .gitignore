```gitignore
# Dependencies
/node_modules/

# Next.js
/.next/
/out/
/build/
tsconfig.tsbuildinfo

# Environment files — never commit real secrets
.env
.env.*
!.env.example

# Miscellaneous
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Vercel
.vercel/

# Testing
/coverage/

# TypeScript
*.tsbuildinfo
```